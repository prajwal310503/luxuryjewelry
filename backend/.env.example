PORT=8000
BACKEND_URL=http://localhost:8000
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/luxury_jewelry?retryWrites=true&w=majority&appName=Cluster0

# ── JWT ────────────────────────────────────────────────────────────────────────
# Use a long random string (32+ chars)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email / SMTP ───────────────────────────────────────────────────────────────
SMTP_HOST=mail.royalbutterfly.in
SMTP_PORT=587
SMTP_EMAIL=no-reply@royalbutterfly.in
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=no-reply@royalbutterfly.in
FROM_NAME=Royal Butterfly

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=royalbutterfly

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@royalbutterfly.in

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Razorpay ───────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Frontend URL ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── SMS (MSG91) ──────────────────────────────────────────────────────────────
# Get from: https://msg91.com — used for order payment reminders
MSG91_AUTH_KEY=
MSG91_SENDER_ID=VKJWLR

# ── WhatsApp / SMS (Twilio — optional) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Admin seed credentials (used by: node src/utils/seeder.js) ─────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=StrongAdminPassword@123

# ── Vendor seed credentials (used by: node src/utils/seedProducts.js) ──────────
VENDOR=vendor@yourdomain.com
PASSWORD=StrongVendorPassword@123
